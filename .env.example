# ===== Telegram Bot =====
BOT_TOKEN=

# ===== MongoDB =====
MONGODB_URI=

# ===== Owner & Admins =====
# Owner can never be removed. ADMIN_IDS is a comma-separated seed list
# (used only if the "admins" collection is empty on first boot).
OWNER_ID=6972909646
ADMIN_IDS=6972909646,7414830213

# ===== Branding =====
BOT_NAME=NexFlix FileVault
BOT_USERNAME=NexFlixFileVaultBot
WEBSITE_URL=https://www.rnexflix.top
DEVELOPER_USERNAME=ahr2215

# ===== Welcome Image =====
# Leave empty on first deploy. The bot will fetch WELCOME_IMAGE_URL once,
# log the resulting Telegram file_id, then you paste that file_id here
# so future /start calls don't depend on the external URL.
WELCOME_IMAGE_FILE_ID=
WELCOME_IMAGE_URL=https://i.postimg.cc/5NyZmwns/retouch-2026081517463865.jpg

# ===== Required Membership Chats =====
MAIN_CHANNEL_ID=@rnexflix
MAIN_CHANNEL_URL=https://t.me/rnexflix

DAILY_UPDATE_CHAT_ID=-1002674103217
# Private chats have no @username -> Telegram URL buttons need an invite link.
# Get this from the channel's Invite Links settings in Telegram.
DAILY_UPDATE_INVITE_LINK=

REQUEST_GROUP_CHAT_ID=-1003666151699
REQUEST_GROUP_INVITE_LINK=https://t.me/+-Bo6KSNJWf9iNjQ1

# ===== File Delivery =====
AUTO_DELETE_SECONDS=600

# ===== Render / Health check =====
PORT=3000
